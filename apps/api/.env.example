# ──────────────────────────────────────────────
# Nexa API - Environment Variables
# ──────────────────────────────────────────────

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
HOST=0.0.0.0
APP_URL=http://localhost:4000

# Database (Prisma + PostGIS)
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexa_dev?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=nexa:

# JWT
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=nexa-api

# Argon2
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# File Uploads
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=debug

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# S3 / Cloudflare R2
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=nexa-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_SIGNED_URL_EXPIRY=3600

# Email (SMTP - use MailHog in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@nexa.app
