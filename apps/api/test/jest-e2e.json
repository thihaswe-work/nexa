{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@nexa/shared$": "<rootDir>/../../packages/shared/src"
  },
  "setupFilesAfterSetup": ["<rootDir>/jest-setup.ts"],
  "globalTeardown": "<rootDir>/jest-teardown.ts"
}
