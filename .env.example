# ──────────────────────────────────────────────
# Nexa - Global Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and adjust values for your environment.

# ── Application ──────────────────────────────
NODE_ENV=production
APP_NAME=nexa
API_URL=https://api.nexa.app
ADMIN_URL=https://admin.nexa.app

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql://nexa:your-password@postgres:5432/nexa_prod?schema=public
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=nexa_prod
DATABASE_USER=nexa
DATABASE_PASSWORD=your-password

# ── Redis ────────────────────────────────────
REDIS_URL=redis://:your-redis-password@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ── Authentication ──────────────────────────
JWT_SECRET=generate-a-64-char-random-hex-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=nexa-api

# ── Admin Dashboard Auth ────────────────────
NEXTAUTH_SECRET=generate-another-random-string
NEXTAUTH_URL=https://admin.nexa.app
NEXT_PUBLIC_API_URL=https://api.nexa.app/api/v1

# ── Object Storage (S3 / Cloudflare R2) ─────
S3_ENDPOINT=https://your-region.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=nexa-uploads
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_PUBLIC_URL=https://cdn.nexa.app

# ── Email (SMTP) ────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
EMAIL_FROM=noreply@nexa.app

# ── Geo / Maps ──────────────────────────────
MAPS_API_KEY=your-maps-api-key
MAX_SEARCH_RADIUS_KM=50

# ── Rate Limiting ───────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Logging ─────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── File Uploads ────────────────────────────
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# ── Mobile Push Notifications ───────────────
FCM_SERVER_KEY=your-firebase-server-key
APNS_KEY_ID=
APNS_TEAM_ID=

# ── Monitoring ──────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-grafana-password
PROMETHEUS_RETENTION=30d

# ── Docker ─────────────────────────────────
COMPOSE_PROJECT_NAME=nexa
